<IfModule mod_rewrite.c>
    RewriteEngine On

    # The hosting document root points at the repository root. Keep Laravel's
    # application files private and route all web requests through /public.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    DirectoryIndex public/index.php
</IfModule>

