APP_NAME="QuotationGlobal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://quotationglobal.com
FRONTEND_URL=https://quotationglobal.com
CORS_ALLOWED_ORIGINS=https://quotationglobal.com,https://www.quotationglobal.com
SANCTUM_STATEFUL_DOMAINS=quotationglobal.com,www.quotationglobal.com
SANCTUM_TOKEN_EXPIRATION=480

LOG_CHANNEL=stack
LOG_LEVEL=debug

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME="noreply@quotationglobal.com"
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@quotationglobal.com"
MAIL_FROM_NAME="${APP_NAME}"

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quotationglobal
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

VITE_APP_NAME="QuotationGlobal"

SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
